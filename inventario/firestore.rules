rules_version = '2';

// ============================================================================
// Firestore Security Rules — base (default) del proyecto devbac-42d14
// ============================================================================
// Fuente de verdad de este repo (inventario web). El Admin SDK (agente HW C#
// y backend Spring) ignora estas reglas y siempre tiene acceso completo.
// CyberWatch quedó descartado: no hay lectura de cliente a sus colecciones.
//
// Deploy (solo reglas, no toca índices ni las otras bases del proyecto):
//   firebase deploy --only firestore:rules
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Campos de usuarios/ que el dueño del perfil puede editar desde el front.
    // `rol` y `activo` quedan deliberadamente afuera: son la base de autorización.
    function camposPerfil() {
      return ['nombre', 'departamento', 'cargo', 'avatarColor',
              'telefono', 'email', 'updatedAt'];
    }

    // Tipos y topes de tamaño para evitar basura y documentos inflados a propósito.
    function perfilBienFormado(data) {
      return (!('nombre'       in data) || (data.nombre       is string && data.nombre.size()       <= 120))
          && (!('departamento' in data) || (data.departamento is string && data.departamento.size() <= 120))
          && (!('cargo'        in data) || (data.cargo        is string && data.cargo.size()        <= 120))
          && (!('avatarColor'  in data) || (data.avatarColor  is string && data.avatarColor.size()  <= 120))
          && (!('telefono'     in data) || (data.telefono     is string && data.telefono.size()     <= 40))
          && (!('updatedAt'    in data) || (data.updatedAt    is string && data.updatedAt.size()    <= 40))
          && (!('email'        in data) || (data.email        is string && data.email.size()        <= 200));
    }

    // Perfil en usuarios/{uid} — get() en reglas no está sujeto a estas mismas reglas.
    function perfilUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function esUsuarioInventarioActivo() {
      return request.auth != null
          && perfilUsuario().exists
          && perfilUsuario().data.activo == true;
    }

    function esAdministrador() {
      return esUsuarioInventarioActivo()
          && perfilUsuario().data.rol == 'ADMINISTRADOR';
    }

    // Alineado con PermisosContext / RoleAuthorizationFilter: USUARIO y ADMINISTRADOR escriben.
    function puedeEscribirInventario() {
      return esUsuarioInventarioActivo()
          && (perfilUsuario().data.rol == 'ADMINISTRADOR'
              || perfilUsuario().data.rol == 'USUARIO');
    }

    function camposWorkflowEventoHardware() {
      return ['estado_seguimiento', 'leido', 'revisado_por', 'revisado_en', 'notas_it'];
    }

    function eventoHardwareWorkflowValido(data) {
      return (!('estado_seguimiento' in data)
              || (data.estado_seguimiento is string
                  && data.estado_seguimiento in [
                    'pendiente', 'en_revision', 'autorizado',
                    'no_autorizado', 'falso_positivo']))
          && (!('leido' in data) || data.leido is bool)
          && (!('revisado_por' in data)
              || data.revisado_por == null
              || (data.revisado_por is string && data.revisado_por.size() <= 200))
          && (!('revisado_en' in data)
              || data.revisado_en == null
              || data.revisado_en is timestamp)
          && (!('notas_it' in data)
              || data.notas_it == null
              || (data.notas_it is string && data.notas_it.size() <= 4000));
    }

    // -------------------------------------------------------------------------
    // config/ — cerrado salvo la lectura del doc del instalador
    // -------------------------------------------------------------------------
    // La escritura queda prohibida al cliente: acá vive la URL de actualización
    // del agente y un write malicioso dispararía una actualización falsa.
    // El front del inventario necesita leer solo config/agente_hw para mostrar
    // la versión y el link de descarga en Sistema.
    match /config/{document} {
      allow read:  if request.auth != null && document == 'agente_hw';
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // computadoras/ — lectura para el dashboard, escritura solo Admin SDK
    // -------------------------------------------------------------------------
    match /computadoras/{machineId} {
      allow read:  if request.auth != null;
      allow write: if false;

      match /programas/{programaId} {
        allow read:  if request.auth != null;
        allow write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // tareas/ — solo lectura; los comandos los emite el backend
    // -------------------------------------------------------------------------
    // El front lee el estado de cada comando (useTareasHW). La escritura desde
    // el cliente está cerrada porque se migró a POST /api/computadoras/{uuid}/comando.
    match /tareas/{machineId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // Logs del agente — lectura para el dashboard, escritura solo Admin SDK
    // -------------------------------------------------------------------------
    match /logs_actualizaciones/{logId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    match /logs_debug/{logId} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // eventos_hardware/ — auditoría de cambios HW (agente crea; IT gestiona workflow)
    // -------------------------------------------------------------------------
    // Create: solo Admin SDK del agente (service account). El front usa API REST;
    // estas reglas defienden acceso directo desde el SDK de Firestore en el cliente.
    // Read: cualquier usuario inventario activo (VISUALIZADOR incluido).
    // Update: USUARIO o ADMINISTRADOR; solo campos de seguimiento IT.
    // Delete: solo ADMINISTRADOR.
    match /eventos_hardware/{eventoId} {
      allow read: if esUsuarioInventarioActivo();

      allow create: if false;

      allow update: if puedeEscribirInventario()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(camposWorkflowEventoHardware())
                    && eventoHardwareWorkflowValido(request.resource.data);

      allow delete: if esAdministrador();
    }

    // -------------------------------------------------------------------------
    // usuarios/ — cada uno solo su propio perfil, sin poder tocar su rol
    // -------------------------------------------------------------------------
    // `rol` y `activo` son la fuente de autorización del backend
    // (RoleAuthorizationFilter los lee de acá), así que el cliente NO puede
    // escribirlos: si pudiera, cualquiera se haría ADMINISTRADOR desde la
    // consola del navegador. hasOnly() los deja fuera de los campos editables.
    match /usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(camposPerfil())
                    && perfilBienFormado(request.resource.data)
                    && request.resource.data.email == request.auth.token.email;

      // En update, request.resource.data es el documento resultante y sigue
      // conteniendo rol/activo, así que el filtro va sobre las claves afectadas.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(camposPerfil())
                    && perfilBienFormado(request.resource.data)
                    && (!('email' in request.resource.data.diff(resource.data).affectedKeys())
                        || request.resource.data.email == request.auth.token.email);

      allow delete: if false;
    }
  }
}
