# Firebase (Firestore en /system + Auth para login y JWT al backend).
# Ubicación: inventario-front/.env (recomendado) o inventario-front/src/.env
# Tras crear o editar .env: detener el servidor y volver a ejecutar `npm run dev`.
# Todas las variables deben usar el prefijo VITE_ para que Vite las exponga al navegador.
# Copiar desde Firebase Console → Configuración del proyecto → Tu app web.
#
# Ejemplo de dominio de auth: <projectId>.firebaseapp.com (p. ej. agentebacar-inventario.firebaseapp.com).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Producción (`npm run build`): obligatorio — URL pública HTTPS del backend Spring (sin barra final).
# Copiar a `.env.production`. Si falta, el build falla (vite.config.js).
# VITE_API_ORIGIN=https://inventario-api-xxxxx.us-central1.run.app
